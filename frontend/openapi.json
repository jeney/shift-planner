{
  "openapi": "3.1.0",
  "info": {
    "title": "Shift Planner API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/calendar/{month}": {
      "get": {
        "tags": [
          "calendar"
        ],
        "summary": "Get Month Calendar",
        "description": "Days of the month with day types, Danish public holidays and notable days.",
        "operationId": "getMonthCalendar",
        "parameters": [
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])$",
              "examples": [
                "2027-01"
              ],
              "title": "Month"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonthCalendar"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/project/new": {
      "get": {
        "tags": [
          "project"
        ],
        "summary": "Get New Project",
        "description": "An empty project for `month`, with every setting at its default.",
        "operationId": "newProject",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])$",
              "examples": [
                "2027-01"
              ],
              "title": "Month"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/project/demo": {
      "get": {
        "tags": [
          "project"
        ],
        "summary": "Get Demo Project",
        "description": "A fictional demo team (9 people) with some availability and wishes.",
        "operationId": "demoProject",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])$",
              "examples": [
                "2027-01"
              ],
              "title": "Month"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/project/migrate": {
      "post": {
        "tags": [
          "project"
        ],
        "summary": "Post Migrate Project",
        "description": "Upgrade a saved project (any schema version) to the current version and validate it.",
        "operationId": "migrateProject",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "type": "object",
                "title": "Raw"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "422": {
            "description": "Not a valid project file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "params",
          "details"
        ],
        "title": "ApiError",
        "description": "Error with a translatable message key; the frontend renders `code` with `params`."
      },
      "AvailabilityEntry": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id"
          },
          "employeeId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Employeeid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "unavailable",
              "wish_off",
              "wish_work"
            ],
            "title": "Kind"
          },
          "pattern": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/WeeklyPattern"
              },
              {
                "$ref": "#/components/schemas/SingleDatePattern"
              },
              {
                "$ref": "#/components/schemas/DateRangePattern"
              }
            ],
            "title": "Pattern",
            "discriminator": {
              "propertyName": "type",
              "mapping": {
                "date": "#/components/schemas/SingleDatePattern",
                "range": "#/components/schemas/DateRangePattern",
                "weekly": "#/components/schemas/WeeklyPattern"
              }
            }
          },
          "weight": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Weight",
            "default": 1.0
          },
          "note": {
            "type": "string",
            "maxLength": 200,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "employeeId",
          "kind",
          "pattern",
          "weight",
          "note"
        ],
        "title": "AvailabilityEntry"
      },
      "BreakRule": {
        "properties": {
          "afterHours": {
            "type": "number",
            "maximum": 24.0,
            "exclusiveMinimum": 0.0,
            "title": "Afterhours"
          },
          "minutes": {
            "type": "integer",
            "maximum": 180.0,
            "minimum": 0.0,
            "title": "Minutes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "afterHours",
          "minutes"
        ],
        "title": "BreakRule",
        "description": "A shift longer than `after_hours` includes a break of `minutes`."
      },
      "BreakSettings": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": false
          },
          "paid": {
            "type": "boolean",
            "title": "Paid",
            "default": false
          },
          "rules": {
            "items": {
              "$ref": "#/components/schemas/BreakRule"
            },
            "type": "array",
            "title": "Rules"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "enabled",
          "paid",
          "rules"
        ],
        "title": "BreakSettings"
      },
      "BusRule": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "earlyCutoff": {
            "$ref": "#/components/schemas/CutoffsByDayType"
          },
          "lateEnabled": {
            "type": "boolean",
            "title": "Lateenabled",
            "default": false
          },
          "lateCutoff": {
            "$ref": "#/components/schemas/CutoffsByDayType"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "enabled",
          "earlyCutoff",
          "lateEnabled",
          "lateCutoff"
        ],
        "title": "BusRule",
        "description": "People who need a ride must start (or end) at exactly the same time as a driver."
      },
      "CalendarDay": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "weekday": {
            "type": "integer",
            "title": "Weekday"
          },
          "isoWeek": {
            "type": "integer",
            "title": "Isoweek"
          },
          "dayType": {
            "type": "string",
            "enum": [
              "weekday",
              "saturday",
              "sunday",
              "holiday"
            ],
            "title": "Daytype"
          },
          "holiday": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "new_years_day",
                  "maundy_thursday",
                  "good_friday",
                  "easter_sunday",
                  "easter_monday",
                  "great_prayer_day",
                  "ascension_day",
                  "whit_sunday",
                  "whit_monday",
                  "christmas_day",
                  "boxing_day"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Holiday"
          },
          "notable": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "constitution_day",
                  "christmas_eve",
                  "new_years_eve"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Notable"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "weekday",
          "isoWeek",
          "dayType",
          "holiday",
          "notable"
        ],
        "title": "CalendarDay"
      },
      "CutoffsByDayType": {
        "properties": {
          "weekday": {
            "type": "string",
            "pattern": "^(?:(?:[01]\\d|2[0-3]):[0-5]\\d|24:00)$",
            "title": "Weekday"
          },
          "saturday": {
            "type": "string",
            "pattern": "^(?:(?:[01]\\d|2[0-3]):[0-5]\\d|24:00)$",
            "title": "Saturday"
          },
          "sunday": {
            "type": "string",
            "pattern": "^(?:(?:[01]\\d|2[0-3]):[0-5]\\d|24:00)$",
            "title": "Sunday"
          },
          "holiday": {
            "type": "string",
            "pattern": "^(?:(?:[01]\\d|2[0-3]):[0-5]\\d|24:00)$",
            "title": "Holiday"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "weekday",
          "saturday",
          "sunday",
          "holiday"
        ],
        "title": "CutoffsByDayType"
      },
      "DateRangePattern": {
        "properties": {
          "type": {
            "type": "string",
            "const": "range",
            "title": "Type",
            "default": "range"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "title": "Startdate"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "title": "Enddate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "startDate",
          "endDate"
        ],
        "title": "DateRangePattern",
        "description": "Whole days from `start_date` to `end_date`, inclusive (e.g. vacation)."
      },
      "DayHours": {
        "properties": {
          "closed": {
            "type": "boolean",
            "title": "Closed",
            "default": false
          },
          "opens": {
            "type": "string",
            "pattern": "^(?:(?:[01]\\d|2[0-3]):[0-5]\\d|24:00)$",
            "title": "Opens",
            "default": "07:00"
          },
          "closes": {
            "type": "string",
            "pattern": "^(?:(?:[01]\\d|2[0-3]):[0-5]\\d|24:00)$",
            "title": "Closes",
            "default": "18:00"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "closed",
          "opens",
          "closes"
        ],
        "title": "DayHours",
        "description": "Opening hours for one day. Times are when the store is open to customers."
      },
      "DayTypeStaffing": {
        "properties": {
          "minAtOpening": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Minatopening",
            "default": 1
          },
          "minAtClosing": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Minatclosing",
            "default": 1
          },
          "dailyHoursMin": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 168.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Dailyhoursmin"
          },
          "dailyHoursMax": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 168.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Dailyhoursmax"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "minAtOpening",
          "minAtClosing",
          "dailyHoursMin",
          "dailyHoursMax"
        ],
        "title": "DayTypeStaffing"
      },
      "Employee": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "title": "Color"
          },
          "active": {
            "type": "boolean",
            "title": "Active",
            "default": true
          },
          "contractHoursPerWeek": {
            "type": "number",
            "maximum": 168.0,
            "minimum": 0.0,
            "title": "Contracthoursperweek"
          },
          "hasCar": {
            "type": "boolean",
            "title": "Hascar",
            "default": false
          },
          "needsRideEarly": {
            "type": "boolean",
            "title": "Needsrideearly",
            "default": false
          },
          "needsRideLate": {
            "type": "boolean",
            "title": "Needsridelate",
            "default": false
          },
          "allowedDriverIds": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "maxLength": 64,
                  "minLength": 1
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alloweddriverids"
          },
          "overrides": {
            "$ref": "#/components/schemas/EmployeeRuleOverrides"
          },
          "balance": {
            "$ref": "#/components/schemas/HourBalance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "color",
          "active",
          "contractHoursPerWeek",
          "hasCar",
          "needsRideEarly",
          "needsRideLate",
          "allowedDriverIds",
          "overrides",
          "balance"
        ],
        "title": "Employee"
      },
      "EmployeeRuleOverrides": {
        "properties": {
          "minShiftHours": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 24.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Minshifthours"
          },
          "maxShiftHours": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 24.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Maxshifthours"
          },
          "maxHoursPerDay": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 24.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Maxhoursperday"
          },
          "minRestHours": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 24.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Minresthours"
          },
          "maxConsecutiveDays": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 31.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Maxconsecutivedays"
          },
          "maxWeeklyHours": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 168.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Maxweeklyhours"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "minShiftHours",
          "maxShiftHours",
          "maxHoursPerDay",
          "minRestHours",
          "maxConsecutiveDays",
          "maxWeeklyHours"
        ],
        "title": "EmployeeRuleOverrides",
        "description": "Per-employee replacements for global limits. `None` means \"use the global rule\"."
      },
      "ErrorDetail": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "loc",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "GuestDemand": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": false
          },
          "mode": {
            "type": "string",
            "enum": [
              "linear",
              "steps"
            ],
            "title": "Mode",
            "default": "linear"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/GuestPoint"
            },
            "type": "array",
            "title": "Points"
          },
          "toleranceHours": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Tolerancehours",
            "default": 2
          },
          "guestsByDate": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "format": "date"
            },
            "type": "object",
            "title": "Guestsbydate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "enabled",
          "mode",
          "points",
          "toleranceHours",
          "guestsByDate"
        ],
        "title": "GuestDemand",
        "description": "Optional: derive each day's required total staff hours from expected guests."
      },
      "GuestPoint": {
        "properties": {
          "guests": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Guests"
          },
          "hours": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Hours"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "guests",
          "hours"
        ],
        "title": "GuestPoint"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse"
      },
      "HourBalance": {
        "properties": {
          "carryInHours": {
            "type": "number",
            "maximum": 500.0,
            "minimum": -500.0,
            "title": "Carryinhours",
            "default": 0
          },
          "periodWeek": {
            "type": "integer",
            "maximum": 104.0,
            "minimum": 1.0,
            "title": "Periodweek",
            "default": 1
          },
          "lastShiftEndedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastshiftendedat"
          },
          "consecutiveDaysAtStart": {
            "type": "integer",
            "maximum": 31.0,
            "minimum": 0.0,
            "title": "Consecutivedaysatstart",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "carryInHours",
          "periodWeek",
          "lastShiftEndedAt",
          "consecutiveDaysAtStart"
        ],
        "title": "HourBalance",
        "description": "Hours carried in from earlier months. The app doesn't remember past months."
      },
      "MonthCalendar": {
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])$",
            "title": "Month"
          },
          "days": {
            "items": {
              "$ref": "#/components/schemas/CalendarDay"
            },
            "type": "array",
            "title": "Days"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "month",
          "days"
        ],
        "title": "MonthCalendar"
      },
      "ObjectiveWeights": {
        "properties": {
          "wishOff": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Wishoff",
            "default": 10
          },
          "wishWork": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Wishwork",
            "default": 4
          },
          "hourBalance": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Hourbalance",
            "default": 5
          },
          "beyondTolerance": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Beyondtolerance",
            "default": 50
